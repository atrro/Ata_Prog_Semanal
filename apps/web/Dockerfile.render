FROM node:24-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_ACCESS_MODE=company
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
RUN npm ci
COPY apps/web apps/web
RUN npm run build -w apps/web

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=10000
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=build --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=app:app /app/node_modules/zod ./node_modules/zod
COPY --chown=app:app apps/web/server ./apps/web/server
COPY --chown=app:app apps/web/src/lib/workspace-schema.ts ./apps/web/src/lib/workspace-schema.ts
USER app
EXPOSE 10000
CMD ["node", "apps/web/server/start.mjs"]
